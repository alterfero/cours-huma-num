  "dcterms:description": [
    {
      "type": "literal",
      "property_id": 4,
      "property_label": "Description",
      "is_public": true,
      "@value": "Le Vea no Tahiti est un hebdomadaire, premier journal en langue tahitienne sous l’administration française.  Il a été créé par une ordonnance du gouverneur Bonard. Il paraît, entre 1850 et 1859, parallèlement à : \"Messager de Tahiti\" qui l'absorbe en 1859."
    }
  ],
